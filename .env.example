# ==============================================================================
# ChatFlow Environment Variables Template
#
# NOTE: This file contains safe template placeholders only.
# Do NOT store real production secrets, passwords, or private keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Database Configuration (Docker Compose - compose.yaml)
# ------------------------------------------------------------------------------
POSTGRES_USER=chatflow
POSTGRES_PASSWORD=chatflow_secret
POSTGRES_DB=chatflow_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (apps/server)
# ------------------------------------------------------------------------------
# HTTP port for the Express & Socket.IO server (Render injects PORT automatically)
PORT=5000

# Runtime environment ('development' | 'test' | 'production')
NODE_ENV=development

# Allowed frontend client origin for CORS, CSRF Origin validation, and Socket.IO handshakes.
# Development: http://localhost:3000
# Production: strictly required HTTPS origin of deployed web client (e.g. https://chat-flow-seven-chi.vercel.app)
CLIENT_URL=http://localhost:3000

# PostgreSQL database connection URL used by Prisma ORM
# Development (local Docker): postgresql://chatflow:chatflow_secret@localhost:5432/chatflow_db?schema=public
# Production (Neon PostgreSQL): postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql://chatflow:chatflow_secret@localhost:5432/chatflow_db?schema=public

# JWT secret key for signing session tokens and short-lived (60s) Socket.IO connection tickets
# In production: strictly required and must be at least 32 characters long.
# In development: if omitted, a local-only development fallback is used.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Session token expiration duration (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Frontend Web Client Configuration (apps/web)
# ------------------------------------------------------------------------------
# Base URL for REST API calls
# Development: defaults to http://localhost:5000
# Production: leave empty or omitted to use same-origin relative paths (/api) proxied via Next.js rewrites
NEXT_PUBLIC_API_URL=http://localhost:5000

# Direct WebSocket URL for Socket.IO connection
# Development: http://localhost:5000
# Production: direct public HTTPS/WSS URL of the Render backend (e.g. https://chatflow-dia0.onrender.com)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. Production Hosting-Specific Variables (Vercel & Render)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings > Environment Variables:
# Used by Next.js server-side rewrites (apps/web/next.config.ts) to forward /api/:path* to Render backend.
# INTERNAL_API_URL=https://chatflow-dia0.onrender.com
